# FitClinicMD — MARKETING ZONE env (fitclinicmd.com).
# ⚠️ THIS ZONE MUST NEVER HANDLE PHI. No patient data, no health information,
# no intake, no clinical content collection. The PHI application is a separate
# repo, separate host, separate env (app.fitclinicmd.com).

# Public URL of this marketing site
NEXT_PUBLIC_SITE_URL=https://fitclinicmd.com

# Where CTAs hand off to (the PHI application — separate zone)
NEXT_PUBLIC_APP_URL=https://app.fitclinicmd.com

# Search indexing. Leave "false" until counsel approves marketing claims —
# prevents unapproved claims being indexed. Set "true" at launch.
NEXT_PUBLIC_SITE_INDEXABLE=false

# --- Privacy-preserving analytics (OFF until configured) ---
# Cookieless, no cross-site identifiers. NEVER send condition/treatment terms
# in event names, URLs or properties. No third-party ad pixels — ever.
# Requires counsel sign-off before enabling (see COUNSEL-REVIEW-PACKET 3.3).
NEXT_PUBLIC_ANALYTICS_ENABLED=false
NEXT_PUBLIC_ANALYTICS_DOMAIN=
NEXT_PUBLIC_ANALYTICS_SRC=

# --- Contact form delivery (general inquiries only — never medical details) ---
# Where contact submissions are delivered (e.g. hello@fitclinicmd.com).
CONTACT_INBOX=
# Paubox Email API (HIPAA-capable transactional email). BOTH the user and key
# are required for the form to actually send — without them it will NOT claim
# success; it tells the visitor to email directly. Get these from the Paubox
# dashboard (API Access). PAUBOX_FROM must be on a Paubox-verified sending
# domain (set up SPF/DKIM for fitclinicmd.com in Paubox first).
PAUBOX_API_USER=
PAUBOX_API_KEY=
PAUBOX_FROM=FitClinicMD <no-reply@fitclinicmd.com>
