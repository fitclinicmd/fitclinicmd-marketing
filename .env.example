# FitClinicMD — MARKETING ZONE env (fitclinicmd.com).
# ⚠️ THIS ZONE MUST NEVER HANDLE PHI. No patient data, no health information,
# no intake, no clinical content collection. The PHI application is a separate
# repo, separate host, separate env (app.fitclinicmd.com).

# Public URL of this marketing site
NEXT_PUBLIC_SITE_URL=https://fitclinicmd.com

# Where CTAs hand off to (the PHI application — separate zone)
NEXT_PUBLIC_APP_URL=https://app.fitclinicmd.com

# Search indexing. Leave "false" until counsel approves marketing claims —
# prevents unapproved claims being indexed. Set "true" at launch.
NEXT_PUBLIC_SITE_INDEXABLE=false

# --- Privacy-preserving analytics (OFF until configured) ---
# Cookieless, no cross-site identifiers. NEVER send condition/treatment terms
# in event names, URLs or properties. No third-party ad pixels — ever.
# Requires counsel sign-off before enabling (see COUNSEL-REVIEW-PACKET 3.3).
NEXT_PUBLIC_ANALYTICS_ENABLED=false
NEXT_PUBLIC_ANALYTICS_DOMAIN=
NEXT_PUBLIC_ANALYTICS_SRC=

# --- Contact form delivery (general inquiries only — never medical details) ---
# Where contact submissions are delivered (e.g. hello@fitclinicmd.com).
CONTACT_INBOX=
# Paubox Email API (HIPAA-capable transactional email). BOTH the user and key
# are required for the form to actually send — without them it will NOT claim
# success; it tells the visitor to email directly. Get these from the Paubox
# dashboard (API Access). PAUBOX_FROM must be on a Paubox-verified sending
# domain (set up SPF/DKIM for fitclinicmd.com in Paubox first).
PAUBOX_API_USER=
PAUBOX_API_KEY=
PAUBOX_FROM=FitClinicMD <no-reply@fitclinicmd.com>

# --- Pre-booking capture (/start) delivery ---
# Where "booking started" notices go (the inbox the conversion agent watches).
# Falls back to CONTACT_INBOX when unset.
BOOKING_INBOX=

# --- GEN Health funnel handoff ---
# The patient app, intake, visits, prescribing, pharmacy and payments run on
# GEN Health's EHR. This marketing site holds NO PHI; it only hands a captured
# lead (with referrer attribution) into GEN Health's hosted assessment/checkout,
# where GEN collects DOB/address/history and treats the patient.
#
# GENHEALTH_ASSESSMENT_URL: the GEN-hosted assessment/checkout link the /start
# step forwards to. Sandbox is on under the same host+key, so set this to a GEN
# sandbox link to test the handoff before launch. When unset, /start falls back
# to the LocumTele booking calendar, then to a "we'll reach out" confirmation.
GENHEALTH_ASSESSMENT_URL=
# Reserved for future server-side reads (patient lookup, product catalog). Not
# needed for the redirect handoff above.
GENHEALTH_API_KEY=
GENHEALTH_BASE_URL=https://api.gen-health.app
# Signing secret for the order webhook that powers /verify provenance. Register
#   POST https://fitclinicmd.com/api/genhealth/webhook
# in GEN Health with this shared secret; the receiver verifies the
# x-webhook-signature HMAC, dedupes on event_id, and writes a tamper-evident
# provenance entry (pharmacy/batch/COA). Until it is set the endpoint returns 503
# and /verify shows the illustrative sample chain.
# ⚠️ PHI-free zone: do NOT enable live writes here until counsel confirms real
# per-order records may surface on the marketing host (vs. only the PHI app).
GENHEALTH_WEBHOOK_SECRET=

# LocumTele booking calendar the /start step forwards to when the GEN
# assessment link is not set. Referrer attribution is appended automatically.
NEXT_PUBLIC_BOOKING_URL=
